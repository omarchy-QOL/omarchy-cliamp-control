{
  "schemaVersion": 1,
  "id": "io.github.ilyazar.cliamp",
  "name": "CLIamp quake",
  "version": "0.1.6",
  "author": "ilyaZar",
  "license": "MIT",
  "description": "Quake-style CLIamp: a TUI in a Hyprland drop-down, that's it. Under 1,000 lines of core code, with measured idle plugin overhead below 4 MiB, excluding CLIamp and its terminal. CLIamp runs in its own special workspace with configurable top-edge geometry (width, height, and placement) and compact bar controls.",
  "kinds": ["service", "bar-widget"],
  "entryPoints": {
    "service": "Service.qml",
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "CLIamp quake",
    "description": "Toggle stock CLIamp and set its alignment and size.",
    "category": "System",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "alignment": "Center",
      "windowWidth": 1200,
      "windowHeight": 600
    },
    "schema": [
      {
        "key": "alignment",
        "type": "enum",
        "label": "Horizontal alignment",
        "options": ["Left", "Center", "Right"],
        "defaultValue": "Center"
      },
      {
        "key": "windowWidth",
        "type": "integer",
        "label": "Window width",
        "min": 1,
        "max": 99999,
        "step": 50,
        "defaultValue": 1200
      },
      {
        "key": "windowHeight",
        "type": "integer",
        "label": "Window height",
        "min": 1,
        "max": 99999,
        "step": 50,
        "defaultValue": 600
      }
    ]
  }
}
