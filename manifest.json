{
  "schemaVersion": 1,
  "id": "io.github.ilyazar.cliamp",
  "name": "CLIamp Window Control",
  "version": "0.1.5",
  "author": "ilyaZar",
  "license": "MIT",
  "description": "Adds a binding-scoped CLIamp drop-down with configurable top-edge geometry and compact bar controls.",
  "kinds": [
    "service",
    "bar-widget"
  ],
  "entryPoints": {
    "service": "Service.qml",
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "CLIamp Window Control",
    "description": "Toggle stock CLIamp and set its alignment and size.",
    "category": "System",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "alignment": "Center",
      "windowWidth": 1200,
      "windowHeight": 600
    },
    "schema": [
      {
        "key": "alignment",
        "type": "enum",
        "label": "Horizontal alignment",
        "options": [
          "Left",
          "Center",
          "Right"
        ],
        "defaultValue": "Center"
      },
      {
        "key": "windowWidth",
        "type": "integer",
        "label": "Window width",
        "min": 1,
        "max": 100000,
        "step": 50,
        "defaultValue": 1200
      },
      {
        "key": "windowHeight",
        "type": "integer",
        "label": "Window height",
        "min": 1,
        "max": 100000,
        "step": 50,
        "defaultValue": 600
      }
    ]
  }
}
