{
  "schemaVersion": 1,
  "id": "io.github.ilyazar.cliamp",
  "name": "CLIamp quake",
  "version": "0.2.1",
  "author": "ilyaZar",
  "license": "MIT",
  "description": "Quake-style CLIamp: a TUI in its own edge-aligned Hyprland drop-down with configurable position and size, compact bar controls, and measured idle plugin overhead below 4 MiB excluding CLIamp and its terminal.",
  "kinds": ["service", "bar-widget"],
  "entryPoints": {
    "service": "Service.qml",
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "CLIamp quake",
    "description": "Toggle stock CLIamp and set its screen edge, position, and size.",
    "category": "System",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "edge": "Top",
      "placement": "Center",
      "dimBackground": true,
      "windowWidth": 1200,
      "windowHeight": 600
    },
    "schema": [
      {
        "key": "edge",
        "type": "enum",
        "label": "Screen edge",
        "options": ["Top", "Right", "Bottom", "Left"],
        "defaultValue": "Top"
      },
      {
        "key": "placement",
        "type": "enum",
        "label": "Edge position",
        "options": ["Start", "Center", "End"],
        "defaultValue": "Center"
      },
      {
        "key": "windowWidth",
        "type": "integer",
        "label": "Window width",
        "min": 1,
        "max": 9999,
        "step": 50,
        "defaultValue": 1200
      },
      {
        "key": "windowHeight",
        "type": "integer",
        "label": "Window height",
        "min": 1,
        "max": 9999,
        "step": 50,
        "defaultValue": 600
      },
      {
        "key": "dimBackground",
        "type": "boolean",
        "label": "Dim background",
        "defaultValue": true
      }
    ]
  }
}
